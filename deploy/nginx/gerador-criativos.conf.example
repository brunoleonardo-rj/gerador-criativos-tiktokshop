# Node must bind to 127.0.0.1:3100 only. Do not expose the Node port publicly.
# Replace the proxy-secret placeholder with the same high-entropy value as TRUSTED_PROXY_SECRET.
server {
    listen 443 ssl http2;
    server_name example.com;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Trusted-Client-IP $remote_addr;
        proxy_set_header X-Trusted-Proxy-Secret REPLACE_WITH_TRUSTED_PROXY_SECRET;
    }
}
