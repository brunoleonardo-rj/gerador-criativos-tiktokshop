FROM node:22.13.1-bookworm-slim AS build

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends g++ make openssl python3 \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@11.11.0

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1 \
    DATA_DIR=/tmp/gerador-criativos-build-data

RUN pnpm install --frozen-lockfile \
    && mkdir -p "$DATA_DIR" \
    && pnpm build \
    && pnpm standalone:prepare

FROM node:22.13.1-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

COPY --from=build --chown=node:node /app/.next/deploy ./

USER node

EXPOSE 3000

CMD ["node", "server.js"]
