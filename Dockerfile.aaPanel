FROM node:22.13.1-bookworm-slim AS build

WORKDIR /app

RUN npm install --global pnpm@11.11.0

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1 \
    ADMIN_USERNAME=build-user \
    ADMIN_PASSWORD=build-password \
    AUTH_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
    TRUSTED_PROXY_SECRET=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb \
    SETTINGS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
    DATA_DIR=/tmp/gerador-criativos-build-data

RUN pnpm install --frozen-lockfile \
    && mkdir -p "$DATA_DIR" \
    && pnpm build \
    && pnpm standalone:prepare

FROM node:22.13.1-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

COPY --from=build --chown=node:node /app/.next/deploy ./

USER node

EXPOSE 3000

CMD ["node", "server.js"]
